@@ -0,0 +1,9 @@
+#version 300 es
+// Full-screen triangle generated from the vertex index, so no vertex buffers are needed.
+out vec2 vUV;
+
+void main() {
+    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
+    vUV = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
diff --git a/app/src/main/assets/framegen/warp.frag b/app/src/main/assets/framegen/warp.frag
new file mode 100644
index 0000000..c5fdcb9
--- /dev/null
+++ b/app/src/main/assets/framegen/warp.frag
@@ -0,0 +1,36 @@
+#version 300 es
+// Builds the in-between frame at time t (0 = frameA, 1 = frameB) from the motion field.
+precision highp float;
+
+uniform sampler2D frameA;
+uniform sampler2D frameB;
+uniform sampler2D flow;
+uniform vec2 flowTexel;     // one flow texel in UV units
+uniform float t;
+
+in vec2 vUV;
+layout(location = 0) out vec4 outColor;
+
+float maxComponent(vec3 v) {
+    return max(v.r, max(v.g, v.b));
+}
+
+void main() {
+    vec2 v = (texture(flow, vUV).rg * 255.0 - 128.0) / 8.0 * flowTexel;
+
+    vec3 a0 = textureLod(frameA, vUV, 0.0).rgb;
+    vec3 b0 = textureLod(frameB, vUV, 0.0).rgb;
+    vec3 a = textureLod(frameA, vUV - t * v, 0.0).rgb;
+    vec3 b = textureLod(frameB, vUV + (1.0 - t) * v, 0.0).rgb;
+
+    // Where the two motion-compensated samples disagree the motion is wrong (usually an
+    // occlusion), so fall back to a plain blend there.
+    float bad = smoothstep(0.12, 0.35, maxComponent(abs(a - b)));
+    vec3 color = mix(mix(a, b, t), mix(a0, b0, t), bad);
+
+    // A pixel that is identical in both frames stays untouched. This keeps the HUD and text sharp.
+    float still = 1.0 - smoothstep(0.004, 0.02, maxComponent(abs(a0 - b0)));
+    color = mix(color, b0, still);
+
+    outColor = vec4(color, 1.0);
+}
