diff --git a/app/src/main/assets/framegen/flow.frag b/app/src/main/assets/framegen/flow.frag
new file mode 100644
index 0000000..0146581
--- /dev/null
+++ b/app/src/main/assets/framegen/flow.frag
@@ -0,0 +1,87 @@
+#version 300 es
+// Bilateral motion estimation. For every texel of the in-between frame it looks for the vector v
+// that makes frameA sampled at (p - v/2) look like frameB sampled at (p + v/2).
+// The vector is stored in flow texels with 1/8 texel precision: byte = v * 8 + 128.
+precision highp float;
+
+uniform sampler2D frameA;
+uniform sampler2D frameB;
+uniform sampler2D coarseFlow;
+uniform float lod;          // mip level of the frames that matches this flow level
+uniform vec2 texel;         // one flow texel in UV units
+uniform float coarseScale;  // 0: no prediction, 2: prediction from the coarser level, 1: same level
+uniform int radius;         // search radius in steps
+uniform float stepSize;     // distance between candidates in flow texels
+uniform int propagate;      // 1: candidates are the vectors of the neighbouring texels of coarseFlow
+
+in vec2 vUV;
+layout(location = 0) out vec4 outFlow;
+
+const float MAX_FLOW = 15.875;
+const float SMOOTH_WEIGHT = 0.06;
+const float ZERO_WEIGHT = 0.004;
+
+vec2 decodeFlow(vec2 e) {
+    return (e * 255.0 - 128.0) / 8.0;
+}
+
+vec2 encodeFlow(vec2 v) {
+    return (v * 8.0 + 128.0) / 255.0;
+}
+
+float matchCost(vec2 v) {
+    vec2 h = 0.5 * v * texel;
+    float cost = 0.0;
+    for (int y = -1; y <= 1; y++) {
+        for (int x = -1; x <= 1; x++) {
+            vec2 o = vUV + vec2(float(x), float(y)) * texel;
+            vec3 d = abs(textureLod(frameA, o - h, lod).rgb - textureLod(frameB, o + h, lod).rgb);
+            cost += d.r + d.g + d.b;
+        }
+    }
+    return cost;
+}
+
+void main() {
+    float bestCost = 1.0e9;
+    float bestSad = 0.0;
+    vec2 bestFlow = vec2(0.0);
+
+    if (propagate == 1) {
+        // Take the best vector among the neighbours. This spreads good vectors and removes outliers.
+        for (int y = -1; y <= 1; y++) {
+            for (int x = -1; x <= 1; x++) {
+                vec2 o = vec2(float(x), float(y));
+                vec2 v = decodeFlow(texture(coarseFlow, vUV + o * texel * stepSize).rg) * coarseScale;
+                float sad = matchCost(v);
+                float cost = sad + SMOOTH_WEIGHT * 0.5 * length(o);
+                if (cost < bestCost) {
+                    bestCost = cost;
+                    bestSad = sad;
+                    bestFlow = v;
+                }
+            }
+        }
+    }
+    else {
+        vec2 base = vec2(0.0);
+        if (coarseScale > 0.0) base = decodeFlow(texture(coarseFlow, vUV).rg) * coarseScale;
+        bestFlow = base;
+
+        for (int y = -radius; y <= radius; y++) {
+            for (int x = -radius; x <= radius; x++) {
+                vec2 d = vec2(float(x), float(y)) * stepSize;
+                vec2 v = clamp(base + d, vec2(-MAX_FLOW), vec2(MAX_FLOW));
+                float sad = matchCost(v);
+                float cost = sad + SMOOTH_WEIGHT * length(d) + ZERO_WEIGHT * length(v);
+                if (cost < bestCost) {
+                    bestCost = cost;
+                    bestSad = sad;
+                    bestFlow = v;
+                }
+            }
+        }
+    }
+
+    outFlow = vec4(encodeFlow(bestFlow), clamp(bestSad / 27.0 * 4.0, 0.0, 1.0), 1.0);
+}
