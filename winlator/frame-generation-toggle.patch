     public void applyFrameGeneration(int multiplier) {
         xServerView.getRenderer().frameGenerator.setMaxMultiplier(multiplier);
         FrameGenerator.requestHighestRefreshRate(this, multiplier >= 2);
+        updateFrameGenerationMenuItem(multiplier);
+    }
+
+    private void updateFrameGenerationMenuItem(int multiplier) {
+        NavigationView navigationView = findViewById(R.id.NavigationView);
+        if (navigationView == null) return;
+        MenuItem menuItem = navigationView.getMenu().findItem(R.id.menu_item_frame_generation);
+        if (menuItem == null) return;
+        String state = multiplier >= 2 ? "x"+multiplier : getString(R.string.disabled);
+        menuItem.setTitle(getString(R.string.frame_generation)+": "+state);
+    }
+
+    /**
+     * Frames can only be generated when the game runs at the refresh rate divided by the multiplier,
+     * so that limit is set automatically unless the user chose a limit of their own.
+     */
+    private void applyFrameGenerationLimit(KeyValueSet config) {
+        int multiplier = preferences.getInt("frame_generation", 1);
+        String framerate = config.get("framerate");
+        if (multiplier < 2 || !(framerate.isEmpty() || framerate.equals("0"))) return;
+
+        float refreshRate = 60.0f;
+        Display display = getWindowManager().getDefaultDisplay();
+        Display.Mode currentMode = display.getMode();
+        for (Display.Mode mode : display.getSupportedModes()) {
+            boolean sameSize = mode.getPhysicalWidth() == currentMode.getPhysicalWidth() && mode.getPhysicalHeight() == currentMode.getPhysicalHeight();
+            if (sameSize) refreshRate = Math.max(refreshRate, mode.getRefreshRate());
+        }
+        config.put("framerate", Math.round(refreshRate / multiplier));
     }
 
