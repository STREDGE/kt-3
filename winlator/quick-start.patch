@@ -30,9 +30,13 @@ import com.winlator.container.Container;
 import com.winlator.container.ContainerManager;
 import com.winlator.contentdialog.ContentDialog;
 import com.winlator.contentdialog.StorageInfoDialog;
+import com.winlator.core.AppUtils;
 import com.winlator.core.PreloaderDialog;
 import com.winlator.xenvironment.RootFS;
 
+import org.json.JSONException;
+import org.json.JSONObject;
+
 import java.util.ArrayList;
 import java.util.List;
 
@@ -69,13 +73,53 @@ public class ContainersFragment extends Fragment {
         DividerItemDecoration itemDecoration = new DividerItemDecoration(recyclerView.getContext(), DividerItemDecoration.VERTICAL);
         itemDecoration.setDrawable(ContextCompat.getDrawable(context, R.drawable.list_item_divider));
         recyclerView.addItemDecoration(itemDecoration);
+        frameLayout.findViewById(R.id.BTQuickStart).setOnClickListener((v) -> quickStart());
         return frameLayout;
     }
 
+    /**
+     * One-tap path for people who just want to run something: makes a container with the default
+     * settings when there is none yet and opens the Downloads folder, where a tap on a file runs it.
+     */
+    private void quickStart() {
+        if (!RootFS.find(getContext()).isValid()) return;
+
+        ArrayList<Container> containers = manager.getContainers();
+        if (!containers.isEmpty()) {
+            openDownloads(containers.get(0));
+            return;
+        }
+
+        JSONObject data = new JSONObject();
+        try {
+            data.put("name", "Container-1");
+        }
+        catch (JSONException e) {
+            return;
+        }
+
+        preloaderDialog.show(R.string.creating_container);
+        manager.createContainerAsync(data, (container) -> {
+            preloaderDialog.close();
+            if (container != null) {
+                loadContainersList();
+                openDownloads(container);
+            }
+            else AppUtils.showToast(getContext(), R.string.unable_to_create_container);
+        });
+    }
+
+    private void openDownloads(Container container) {
+        MainActivity activity = (MainActivity)getActivity();
+        if (activity == null) return;
+        AppUtils.showToast(activity, R.string.quick_start_hint);
+        activity.showFragment(new ContainerFileManagerFragment(container.id, AppUtils.DIRECTORY_DOWNLOADS));
+    }
+
     private void loadContainersList() {
         ArrayList<Container> containers = manager.getContainers();
         recyclerView.setAdapter(new ContainersAdapter(containers));
-        if (containers.isEmpty()) emptyTextView.setVisibility(View.VISIBLE);
+        emptyTextView.setVisibility(containers.isEmpty() ? View.VISIBLE : View.GONE);
     }
 
     @Override
