diff --git a/app/src/main/java/com/winlator/core/HomeScreenShortcut.java b/app/src/main/java/com/winlator/core/HomeScreenShortcut.java
new file mode 100644
index 0000000..d5eae40
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/HomeScreenShortcut.java
@@ -0,0 +1,52 @@
+package com.winlator.core;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ShortcutInfo;
+import android.content.pm.ShortcutManager;
+import android.graphics.Bitmap;
+import android.graphics.drawable.Icon;
+
+import com.winlator.R;
+import com.winlator.ShortcutLauncherActivity;
+
+/** Puts an icon on the Android home screen that starts a program without opening the Winlator menus. */
+public abstract class HomeScreenShortcut {
+    private static final short ICON_SIZE = 192;
+
+    /**
+     * @param extraName "shortcut_path" for a Winlator shortcut (.desktop) or "exec_path" for a file,
+     *                  the same extras that XServerDisplayActivity reads.
+     */
+    public static void request(Context context, int containerId, String extraName, String path, String label, Bitmap icon) {
+        ShortcutManager shortcutManager = context.getSystemService(ShortcutManager.class);
+        if (shortcutManager == null || !shortcutManager.isRequestPinShortcutSupported()) {
+            AppUtils.showToast(context, R.string.home_screen_shortcuts_not_supported);
+            return;
+        }
+
+        Intent intent = new Intent(context, ShortcutLauncherActivity.class);
+        intent.setAction(Intent.ACTION_VIEW);
+        intent.putExtra("container_id", containerId);
+        intent.putExtra(extraName, path);
+
+        Icon shortcutIcon = icon != null
+            ? Icon.createWithBitmap(Bitmap.createScaledBitmap(icon, ICON_SIZE, ICON_SIZE, true))
+            : Icon.createWithResource(context, R.mipmap.ic_launcher);
+
+        String id = "launch-"+containerId+"-"+Integer.toHexString(path.hashCode());
+        ShortcutInfo shortcutInfo = new ShortcutInfo.Builder(context, id)
+            .setShortLabel(label)
+            .setLongLabel(label)
+            .setIcon(shortcutIcon)
+            .setIntent(intent)
+            .build();
+
+        try {
+            shortcutManager.requestPinShortcut(shortcutInfo, null);
+        }
+        catch (IllegalArgumentException | IllegalStateException e) {
+            AppUtils.showToast(context, R.string.home_screen_shortcuts_not_supported);
+        }
+    }
+}
