diff --git a/app/src/main/java/com/winlator/ShortcutLauncherActivity.java b/app/src/main/java/com/winlator/ShortcutLauncherActivity.java
new file mode 100644
index 0000000..6912767
--- /dev/null
+++ b/app/src/main/java/com/winlator/ShortcutLauncherActivity.java
@@ -0,0 +1,51 @@
+package com.winlator;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import com.winlator.container.ContainerManager;
+import com.winlator.xenvironment.RootFS;
+import com.winlator.xenvironment.RootFSInstaller;
+
+import java.io.File;
+
+/**
+ * Started by a home screen icon. Checks that the program can still be launched and hands over to
+ * XServerDisplayActivity; if something is missing it opens the normal Winlator screen instead.
+ * XServerDisplayActivity is singleTask, so tapping the icon while it is already running only
+ * brings it back to the front.
+ */
+public class ShortcutLauncherActivity extends Activity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        Intent source = getIntent();
+        int containerId = source.getIntExtra("container_id", 0);
+        String shortcutPath = source.getStringExtra("shortcut_path");
+        String execPath = source.getStringExtra("exec_path");
+        String path = shortcutPath != null ? shortcutPath : execPath;
+
+        Intent intent = null;
+        RootFS rootFS = RootFS.find(this);
+        boolean rootFSReady = rootFS.isValid() && rootFS.getVersion() >= RootFSInstaller.LATEST_VERSION;
+        if (rootFSReady && path != null && (new File(path)).exists()) {
+            ContainerManager manager = new ContainerManager(this);
+            if (manager.getContainerById(containerId) != null) {
+                intent = new Intent(this, XServerDisplayActivity.class);
+                intent.putExtra("container_id", containerId);
+                intent.putExtra(shortcutPath != null ? "shortcut_path" : "exec_path", path);
+            }
+        }
+
+        if (intent == null) {
+            Toast.makeText(getApplicationContext(), R.string.unable_to_launch_from_home_screen, Toast.LENGTH_LONG).show();
+            intent = new Intent(this, MainActivity.class);
+        }
+
+        startActivity(intent);
+        finish();
+    }
+}
